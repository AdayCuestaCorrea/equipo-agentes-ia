# Copia este fichero a .env.local y rellena los valores. Nunca subas .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: escribe saltándose RLS. Nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Cadena aleatoria larga: encadena los pasos del motor
STEP_SECRET=
# Vercel lo envía como Bearer al cron de keepalive
CRON_SECRET=
DEMO_MODE=false
MAX_LIVE_RUNS_PER_DAY=20